<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MainViewController">

    <center>
        <AnchorPane fx:id="canvasContainer" style="-fx-padding: 10;">
            <Canvas fx:id="canvas"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0" />
        </AnchorPane>
    </center>

    <right>
        <VBox spacing="10" minWidth="200.0" prefWidth="200.0"
              style="-fx-padding: 10; -fx-background-color: #f0f0f0;">
            <Label text="Режим заливки:" />
            <ComboBox fx:id="fillModeSelector" />

            <Label fx:id="vertexColorLabel1" text="Цвет вершины 1:" />
            <ColorPicker fx:id="vertexColor1" />

            <Label fx:id="vertexColorLabel2" text="Цвет вершины 2:" />
            <ColorPicker fx:id="vertexColor2" />

            <Label fx:id="vertexColorLabel3" text="Цвет вершины 3:" />
            <ColorPicker fx:id="vertexColor3" />

            <Button fx:id="drawButton" text="Заполнить треугольник" />
            <Button fx:id="clearButton" text="Очистить" />
        </VBox>
    </right>
</BorderPane>